<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cardo_bold"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <ImageButton
            android:id="@+id/tombol_cari"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:contentDescription="@string/cari_surat"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tab_area"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/tab_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_surat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:stateListAnimator="@animator/tab_press"
                android:text="@string/tab_surat"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tab_juz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:stateListAnimator="@animator/tab_press"
                android:text="@string/tab_juz"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tab_penanda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:stateListAnimator="@animator/tab_press"
                android:text="@string/tab_penanda"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Garis penanda tab aktif; ikut bergeser mengikuti geseran halaman. -->
        <View
            android:id="@+id/tab_indicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="@color/accent" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

    <!-- Tombol mengambang: buka halaman terakhir yang dibaca. -->
    <ImageButton
        android:id="@+id/fab_terakhir"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/halaman_terakhir"
        android:elevation="6dp"
        android:src="@drawable/ic_book_open" />
</FrameLayout>
