<?xml version="1.0" encoding="utf-8"?>
<!-- Menu Lompat: tinggi tetap 420dp (diatur di LompatDialog), tidak berubah saat ganti tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Pegangan: digeser ke bawah untuk menutup menu -->
    <FrameLayout
        android:id="@+id/pegangan"
        android:layout_width="match_parent"
        android:layout_height="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@color/frame" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/cardo_bold"
        android:text="@string/lompat_judul"
        android:textColor="@color/text"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_juz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/lompat_juz"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tab_surat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/lompat_surat"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Area isi: mengisi sisa tinggi menu (ikut membesar saat pegangan digeser ke atas) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Tab Juz: dropdown juz di atas, input halaman di bawah -->
        <FrameLayout
            android:id="@+id/panel_juz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lompat_juz"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btn_juz"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_isi"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/teks_juz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/panah_juz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lompat_panah_bawah"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dropdown juz: muncul ke bawah dan menutup input halaman, tombol Lompat, dan Batal -->
            <ListView
                android:id="@+id/list_juz"
                android:layout_width="match_parent"
                android:layout_height="198dp"
                android:layout_marginTop="74dp"
                android:background="@drawable/bg_menu"
                android:divider="@null"
                android:elevation="8dp"
                android:padding="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="74dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lompat_nomor_halaman"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inp_halaman"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_isi"
                    android:gravity="center_vertical"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hint_halaman"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/lompat_hint_halaman"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab Surat: dropdown surat di atas, input ayat di bawah -->
        <FrameLayout
            android:id="@+id/panel_surat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lompat_surat_label"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btn_surat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_isi"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/teks_surat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/panah_surat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lompat_panah_bawah"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_surat"
                android:layout_width="match_parent"
                android:layout_height="198dp"
                android:layout_marginTop="74dp"
                android:background="@drawable/bg_menu"
                android:divider="@null"
                android:elevation="8dp"
                android:padding="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="74dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lompat_ayat_label"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inp_ayat"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_isi"
                    android:gravity="center_vertical"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hint_ayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_batal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/lompat_batal"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_lompat"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_on"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/lompat_lompat"
            android:textColor="#0F1210"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
