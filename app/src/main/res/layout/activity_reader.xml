<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/pesan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#F2121413"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/opsi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:contentDescription="@string/opsi"
            android:src="@drawable/ic_more" />

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:contentDescription="@string/kembali"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cardo_bold"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/penanda"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ripple"
            android:contentDescription="@string/penanda"
            android:src="@drawable/ic_bookmark" />
    </LinearLayout>
</FrameLayout>
